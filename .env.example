# Copy this file to .env (docker compose reads it automatically).

# MySQL database (runs in the "db" container).
MYSQL_DATABASE=cato
MYSQL_USER=cato
MYSQL_PASSWORD=cato
MYSQL_ROOT_PASSWORD=root
DATABASE_URL=mysql+pymysql://cato:cato@db:3306/cato

# Where uploaded videos and resumes are saved. Inside Docker this is the "uploads" volume.
STORAGE_DIR=/data/uploads

# Fill the database with dummy users and profiles on first start.
SEED_DUMMY_DATA=true

# Address the React dev server uses to reach the server.
VITE_API_TARGET=http://server:8000

# Cloudinary storage. Leave empty to keep files in the Docker volume.
# Copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=
